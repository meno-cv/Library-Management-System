<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="470.0" prefWidth="650.0"
            stylesheets="@../style.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.DashBoardButtons.AddBookController">

   <children>
      <VBox spacing="60.0"
            AnchorPane.topAnchor="25.0"
            AnchorPane.bottomAnchor="25.0"
            AnchorPane.leftAnchor="35.0"
            AnchorPane.rightAnchor="35.0">

         <children>
            <Label text="Add Book"
                   maxWidth="Infinity"
                   alignment="CENTER"
                   style="-fx-text-fill: #8c6a47;
                              -fx-font-size: 28px;
                              -fx-font-family: Georgia;"/>

            <GridPane hgap="20.0" vgap="15.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="145.0"
                                     prefWidth="145.0"/>
                  <ColumnConstraints hgrow="ALWAYS"
                                     minWidth="200.0"/>
               </columnConstraints>

               <children>
                  <Label fx:id="lblBookID"
                         text="Book ID:"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="0"/>

                  <TextField fx:id="txtBookID"
                             promptText="Enter Book ID"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="0"/>

                  <Label fx:id="lblBookTitle"
                         text="Book Title:"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="1"/>

                  <TextField fx:id="txtBookTitle"
                             promptText="Enter Book Title"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="1"/>

                  <Label fx:id="lblAuthor"
                         text="Author:"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="2"/>

                  <TextField fx:id="txtAuthor"
                             promptText="Enter Author"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="2"/>

                  <Label fx:id="lblCategory"
                         text="Category:"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="3"/>

                  <TextField fx:id="txtCategory"
                             promptText="Enter Category"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="3"/>

                  <Label fx:id="lblPublishedYear"
                         text="Published Year:"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="4"/>

                  <TextField fx:id="txtPublishedYear"
                             promptText="Enter Published Year"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="4"/>

                  <Label fx:id="lblQuantity"
                         text="Quantity:"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="5"/>

                  <Spinner fx:id="spnQuantity"
                           maxWidth="Infinity"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="5"/>
               </children>
            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Button fx:id="btnBack"
                          onAction="#btnBackOnAction"
                          mnemonicParsing="false"
                          text="← Back to Dashboard"/>

                  <Region HBox.hgrow="ALWAYS"/>

                  <Button fx:id="btnAddBook"
                          onAction="#btnAddBookOnAction"
                          mnemonicParsing="false"
                          text="Add Book"/>

                  <Button fx:id="btnClear"
                          onAction="#btnClearOnAction"
                          mnemonicParsing="false"
                          text="Clear"
                          style="-fx-background-color: #e8ded0;
                                       -fx-text-fill: #6f5034;"/>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>