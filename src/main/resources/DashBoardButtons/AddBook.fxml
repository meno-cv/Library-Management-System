<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="603.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.DashBoardButtons.AddBook">
   <children>
      <Label layoutX="235.0" layoutY="22.0" text="Add Book" textFill="#916d3d" underline="true">
         <font>
            <Font name="Serif Regular" size="32.0" />
         </font>
      </Label>
      <HBox layoutX="66.0" layoutY="87.0" prefHeight="246.0" prefWidth="450.0">
         <children>
            <VBox alignment="CENTER_LEFT" prefHeight="234.0" prefWidth="133.0" spacing="17.0">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label fx:id="lblBookID" text="Book ID : " />
                  <Label fx:id="lblBookTitle" text="Book Title :" />
                  <Label fx:id="lblAuthor" text="Author :" />
                  <Label fx:id="lblCategory" text="Category : " />
                  <Label fx:id="lblPublishedYear" text="Published Year : " />
                  <Label fx:id="lblQuantity" text="Quantity :" />
               </children>
            </VBox>
            <VBox prefHeight="246.0" prefWidth="194.0" spacing="10.0">
               <children>
                  <TextField promptText="Enter Book ID" />
                  <TextField promptText="Enter Book Title" />
                  <TextField promptText="Enter Author" />
                  <TextField promptText="Enter Category" />
                  <DatePicker />
                  <Spinner />
               </children>
               <padding>
                  <Insets bottom="15.0" left="15.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
      <Button fx:id="btnAddBook" layoutX="402.0" layoutY="344.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="77.0" style="-fx-background-color: #8c6a47;" text="Add Book" textFill="#ffba53" />
      <Button fx:id="btnClear" layoutX="497.0" layoutY="344.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="77.0" style="-fx-background-color: #8c6a47;" text="Clear" textFill="#fff383" />
   </children>
</AnchorPane>
