<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="520.0" prefWidth="700.0"
            stylesheets="@../style.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.DashBoardButtons.ManageMembersController">

   <children>
      <VBox spacing="25.0"
            AnchorPane.topAnchor="25.0"
            AnchorPane.bottomAnchor="25.0"
            AnchorPane.leftAnchor="35.0"
            AnchorPane.rightAnchor="35.0">

         <children>
            <Label text="Manage Members"
                   maxWidth="Infinity"
                   alignment="CENTER"
                   style="-fx-text-fill: #8c6a47;
                              -fx-font-size: 28px;
                              -fx-font-family: Georgia;"/>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Label text="Search Members:"
                         style="-fx-font-weight: bold;"/>

                  <TextField fx:id="txtSearch"
                             promptText="Search by member details..."
                             HBox.hgrow="ALWAYS"/>

                  <Button fx:id="btnAddMember"
                          onAction="#btnAddMemberOnAction"
                          mnemonicParsing="false"
                          text="+ Add Member"/>
               </children>
            </HBox>

            <TableView fx:id="tableMembers"
                       VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colID"
                               text="ID"
                               prefWidth="90.0"/>

                  <TableColumn fx:id="colName"
                               text="Name"
                               prefWidth="150.0"/>

                  <TableColumn fx:id="colEmail"
                               text="Email"
                               prefWidth="200.0"/>

                  <TableColumn fx:id="colPhone"
                               text="Phone"
                               prefWidth="130.0"/>
               </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Button fx:id="btnBack"
                          onAction="#btnBackOnAction"
                          mnemonicParsing="false"
                          text="← Back to Dashboard"/>

                  <Region HBox.hgrow="ALWAYS"/>

                  <Button fx:id="btnEdit"
                          onAction="#btnEditOnAction"
                          mnemonicParsing="false"
                          text="Edit"/>

                  <Button fx:id="btnDelete"
                          onAction="#btnDeleteOnAction"
                          mnemonicParsing="false"
                          text="Delete"
                          style="-fx-background-color: #8b4545;"/>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>