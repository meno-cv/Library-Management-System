      <Button fx:id="btnDelete" layoutX="493.0" layoutY="349.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="64.0" style="-fx-background-color: #8c6a47;" text="Delete" textFill="#ffeebe" />
