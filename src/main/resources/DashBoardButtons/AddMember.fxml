<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="650.0"
            stylesheets="@../style.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.DashBoardButtons.AddMemberController">

   <children>
      <VBox spacing="35.0"
            AnchorPane.topAnchor="25.0"
            AnchorPane.bottomAnchor="25.0"
            AnchorPane.leftAnchor="35.0"
            AnchorPane.rightAnchor="35.0">

         <children>
            <Label text="Add Member"
                   maxWidth="Infinity"
                   alignment="CENTER"
                   style="-fx-text-fill: #8c6a47;
                              -fx-font-size: 28px;
                              -fx-font-family: Georgia;"/>

            <GridPane hgap="20.0" vgap="18.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="145.0"
                                     prefWidth="145.0"/>
                  <ColumnConstraints hgrow="ALWAYS"
                                     minWidth="200.0"/>
               </columnConstraints>

               <children>
                  <Label fx:id="lblMemberID"
                         text="Member ID:"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="0"/>

                  <TextField fx:id="txtMemberID"
                             promptText="Enter Member ID"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="0"/>

                  <Label fx:id="lblFullName"
                         text="Full Name:"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="1"/>

                  <TextField fx:id="txtFullName"
                             promptText="Enter Full Name"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="1"/>

                  <Label fx:id="lblEmail"
                         text="Email:"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="2"/>

                  <TextField fx:id="txtEmail"
                             promptText="Enter Email"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="2"/>

                  <Label fx:id="lblPhoneNumber"
                         text="Phone Number:"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="3"/>

                  <TextField fx:id="txtPhoneNumber"
                             promptText="Enter Phone Number"
                             maxWidth="Infinity"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="3"/>

                  <Label fx:id="lblAddress"
                         text="Address:"
                         GridPane.columnIndex="0"
                         GridPane.rowIndex="4"/>

                  <TextArea fx:id="txtAddress"
                            promptText="Enter Address"
                            prefRowCount="3"
                            wrapText="true"
                            maxWidth="Infinity"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="4"/>
               </children>
            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>

                  <Region HBox.hgrow="ALWAYS"/>

                  <Button fx:id="btnRegisterMember"
                          onAction="#btnRegisterMemberOnAction"
                          mnemonicParsing="false"
                          text="Register Member"/>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
