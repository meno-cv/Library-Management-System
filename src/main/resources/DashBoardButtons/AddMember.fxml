<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.DashBoardButtons.AddMemberController">
   <children>
      <Label layoutX="225.0" layoutY="34.0" text="Add Member" textFill="#a67315" underline="true">
         <font>
            <Font name="Serif Bold Italic" size="28.0" />
         </font>
      </Label>
      <HBox layoutX="76.0" layoutY="97.0" prefHeight="246.0" prefWidth="450.0">
         <children>
            <VBox alignment="CENTER_LEFT" prefHeight="234.0" prefWidth="133.0" spacing="17.0">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label fx:id="lblMemberID" text="Member ID :" />
                  <Label fx:id="lblFullName" text="Full Name :" />
                  <Label fx:id="lblEmail" text="Email :" />
                  <Label fx:id="lblPhoneNumber" text="Phone Number :" />
                  <Label fx:id="lblAddress" text="Address :" />
                  <Label fx:id="lblQuantity" />
               </children>
            </VBox>
            <VBox prefHeight="246.0" prefWidth="194.0" spacing="10.0">
               <children>
                  <TextField fx:id="txtMemberID" promptText="Enter ID" />
                  <TextField fx:id="txtFullName" promptText="Enter Full Name" />
                  <TextField fx:id="txtEmail" promptText="Enter Email" />
                  <TextField fx:id="txtPhoneNumber" promptText="Enter Phone Number" />
                  <TextArea fx:id="txtAddress" prefHeight="200.0" prefWidth="200.0" />
               </children>
               <padding>
                  <Insets bottom="15.0" left="15.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
      <Button fx:id="btnRegisterMember" layoutX="405.0" layoutY="337.0" mnemonicParsing="false" onAction="#btnRegisterMemberOnAction" prefHeight="31.0" prefWidth="133.0" style="-fx-background-color: #8c6a47;" text="Register Member" textFill="#f8ab45">
         <font>
            <Font name="Noto Sans Armenian Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
