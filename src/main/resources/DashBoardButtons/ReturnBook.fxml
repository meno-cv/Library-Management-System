<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="440.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.DashBoardButtons.ReturnBookController">

   <children>

      <Label layoutX="215.0" layoutY="29.0" text="Return Book" textFill="#a35817" underline="true">
         <font>
            <Font name="Serif Bold Italic" size="32.0" />
         </font>
      </Label>

      <Button fx:id="btnBack" layoutX="47.0" layoutY="368.0" mnemonicParsing="false" onAction="#btnBackOnAction" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: #8c6a47;" text="← Back to Dashboard" textFill="#ffeebe" />

      <VBox alignment="CENTER_LEFT" layoutX="90.0" layoutY="100.0" prefHeight="230.0" prefWidth="180.0" spacing="25.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label text="Select Borrowing :" />
            <Label fx:id="lblMemberInformation" text="Member Information :" />
            <Label fx:id="lblBorrowedDate" text="Borrowed Date :" />
            <Label fx:id="lblDueDate" text="Due Date :" />
            <Label fx:id="lblReturnDate" text="Return Date :" />
            <Label fx:id="lblOverdueStatus" text="Overdue Status :" />
         </children>
      </VBox>

      <VBox layoutX="275.0" layoutY="100.0" prefHeight="230.0" prefWidth="240.0" spacing="15.0">
         <padding>
            <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
         </padding>
         <children>
            <ComboBox fx:id="cmbBorrowing" prefWidth="220.0" promptText="Select borrowed book" />

            <Label fx:id="lblMemberValue" text="-" />

            <Label fx:id="lblBorrowedDateValue" text="-" />

            <Label fx:id="lblDueDateValue" text="-" />

            <DatePicker fx:id="dpReturnDate" prefWidth="220.0" />

            <Label fx:id="lblOverdueValue" text="-" />
         </children>
      </VBox>

      <Button fx:id="btnReturnBook" layoutX="293.0" layoutY="364.0" mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="37.0" prefWidth="165.0" style="-fx-background-color: #8c6a47;" text="Return Book" textFill="#ffc955">
         <font>
            <Font name="Noto Sans Armenian Bold" size="12.0" />
         </font>
      </Button>

   </children>

</AnchorPane>
