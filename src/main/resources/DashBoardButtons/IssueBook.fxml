<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.DashBoardButtons.IssueBookController">
   <children>
      <Label layoutX="228.0" layoutY="30.0" text="Issue Book" textFill="#86560e" underline="true">
         <font>
            <Font name="Serif Bold Italic" size="32.0" />
         </font>
      </Label>
      <VBox alignment="CENTER_LEFT" layoutX="166.0" layoutY="104.0" prefHeight="234.0" prefWidth="133.0" spacing="30.0">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets bottom="10.0" left="10.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label fx:id="lblSelectMember" text="Select Member :" />
            <Label fx:id="lblSelectBook" text="Select Book :" />
            <Label fx:id="lblSelectDate" text="Issue Date :" />
            <Label fx:id="lblDueDate" text="Due Date :" />
            <Label fx:id="lblQuantity" />
         </children>
      </VBox>
      <VBox layoutX="277.0" layoutY="104.0" prefHeight="191.0" prefWidth="133.0" spacing="20.0">
         <children>
            <ComboBox fx:id="cmbMember" prefHeight="25.0" prefWidth="125.0" promptText="Select member"/>
            <ComboBox fx:id="cmbBook" prefWidth="150.0" promptText="Select book"/>
            <DatePicker fx:id="dpIssueDate" promptText="Issue date"/>
            <DatePicker fx:id="dpDueDate" promptText="Due date"/>
         </children>
         <padding>
            <Insets bottom="10.0" left="5.0" right="5.0" top="20.0"/>
         </padding>
      </VBox>
      <Button fx:id="btnIssueBook" layoutX="233.0" layoutY="322.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="165.0" style="-fx-background-color: #8c6a47;" text="Issue Book" textFill="#ffc955">
         <font>
            <Font name="Noto Sans Armenian Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
