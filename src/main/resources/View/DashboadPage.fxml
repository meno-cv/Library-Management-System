<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<AnchorPane prefHeight="448.0" prefWidth="750.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.home.DashboardPageController">

   <children>
      <BorderPane prefHeight="448.0" prefWidth="750.0"
                  AnchorPane.bottomAnchor="0.0"
                  AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0"
                  AnchorPane.topAnchor="0.0">

         <top>
            <HBox alignment="CENTER" prefHeight="75.0">
               <children>
                  <Label text="Library Dashboard"
                         style="-fx-text-fill: #8c6a47; -fx-font-size: 28px; -fx-font-family: Georgia; -fx-font-weight: bold;"/>
               </children>
            </HBox>
         </top>

         <left>
            <VBox prefWidth="190.0" spacing="15.0">
               <padding>
                  <Insets top="20.0" right="12.0" bottom="15.0" left="12.0"/>
               </padding>

               <children>
                  <Button fx:id="btnDashBoard"
                          mnemonicParsing="false"
                          maxWidth="Infinity"
                          text="Dashboard"/>

                  <Button fx:id="btnBooks"
                          mnemonicParsing="false"
                          onAction="#btnBooksOnAction"
                          maxWidth="Infinity"
                          text="Books"/>

                  <Button fx:id="btnMembers"
                          mnemonicParsing="false"
                          onAction="#btnMembersOnAction"
                          maxWidth="Infinity"
                          text="Members"/>

                  <Button fx:id="btnIssueBook"
                          mnemonicParsing="false"
                          onAction="#btnIssueBookOnAction"
                          maxWidth="Infinity"
                          text="Issue Book"/>

                  <Button fx:id="btnReturnBook"
                          mnemonicParsing="false"
                          onAction="#btnReturnBookOnAction"
                          maxWidth="Infinity"
                          text="Return Book"/>

                  <Button fx:id="btnBorrowingHistory"
                          mnemonicParsing="false"
                          onAction="#btnBorrowingHistoryOnAction"
                          maxWidth="Infinity"
                          text="Borrowing History"
                          wrapText="true"/>

                  <Button fx:id="btnLogOut"
                          mnemonicParsing="false"
                          onAction="#btnLogOutOnAction"
                          maxWidth="Infinity"
                          text="Log Out"/>
               </children>
            </VBox>
         </left>

         <center>
            <VBox alignment="CENTER" spacing="20.0"
                  BorderPane.alignment="CENTER">

               <padding>
                  <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
               </padding>

               <children>
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <VBox alignment="CENTER"
                              prefWidth="180.0"
                              prefHeight="120.0"
                              spacing="12.0"
                              styleClass="stat-card">
                           <children>
                              <Label text="Total Books">
                                 <font>
                                    <Font size="17.0"/>
                                 </font>
                              </Label>

                              <Label fx:id="lblTotalBooks" text="0">
                                 <font>
                                    <Font name="System Bold" size="26.0"/>
                                 </font>
                              </Label>
                           </children>
                        </VBox>

                        <VBox alignment="CENTER"
                              prefWidth="180.0"
                              prefHeight="120.0"
                              spacing="12.0"
                              styleClass="stat-card">
                           <children>
                              <Label text="Total Members">
                                 <font>
                                    <Font size="17.0"/>
                                 </font>
                              </Label>

                              <Label fx:id="lblTotalMembers" text="0">
                                 <font>
                                    <Font name="System Bold" size="26.0"/>
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <VBox alignment="CENTER"
                              prefWidth="180.0"
                              prefHeight="120.0"
                              spacing="12.0"
                              styleClass="stat-card">
                           <children>
                              <Label text="Currently Borrowed">
                                 <font>
                                    <Font size="16.0"/>
                                 </font>
                              </Label>

                              <Label fx:id="lblCurrentlyBorrowed" text="0">
                                 <font>
                                    <Font name="System Bold" size="26.0"/>
                                 </font>
                              </Label>
                           </children>
                        </VBox>

                        <VBox alignment="CENTER"
                              prefWidth="180.0"
                              prefHeight="120.0"
                              spacing="12.0"
                              styleClass="stat-card">
                           <children>
                              <Label text="Overdue">
                                 <font>
                                    <Font size="17.0"/>
                                 </font>
                              </Label>

                              <Label fx:id="lblOverdue" text="0">
                                 <font>
                                    <Font name="System Bold" size="26.0"/>
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </center>

      </BorderPane>
   </children>

   <stylesheets>
      <URL value="@../style.css"/>
   </stylesheets>

</AnchorPane>